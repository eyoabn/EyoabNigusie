# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# REQUIRED for the /admin dashboard. If unset, admin endpoints return 503.
# Use a long random value, e.g. `openssl rand -base64 32`
ADMIN_PASSWORD=

# EXTRA origins allowed to call this API, comma separated, no trailing slashes.
# The deployed front end is already allowed in server.js (SITE_ORIGINS) and local
# dev servers are allowed automatically whenever NODE_ENV is not "production",
# so this is only needed for a custom domain or a preview deployment.
ALLOWED_ORIGINS=

# Check what the server actually has wired up at any time:
#   curl https://<your-api-host>/api/health

# Gmail notification for new contact messages (optional).
# EMAIL_PASS must be a Google App Password, not your account password.
EMAIL_USER=
EMAIL_PASS=
