# Copy to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# REQUIRED for the /admin dashboard. If unset, admin endpoints return 503.
# Use a long random value, e.g. `openssl rand -base64 32`
ADMIN_PASSWORD=

# Comma-separated list of origins allowed to call this API.
# Falls back to localhost only when unset.
ALLOWED_ORIGINS=http://localhost:5173,https://your-portfolio-domain.com

# Gmail notification for new contact messages (optional).
# EMAIL_PASS must be a Google App Password, not your account password.
EMAIL_USER=
EMAIL_PASS=
